VITE_API_BASE_URL=http://localhost:8000
# Optional: set backend API key for protected POST endpoints (/jobs/deepread, /feedback, /obsidian/sync, /jobs/:jobId/cancel)
# VITE_API_KEY=
# Optional: when enabled, disable automatic mock fallback and surface backend errors directly
# VITE_STRICT_API=1
# Optional: force UI to run fully in mock mode
# VITE_FORCE_MOCK=0
