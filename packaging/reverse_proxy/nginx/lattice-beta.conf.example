server {
    listen 443 ssl http2;
    server_name beta.example.com;

    # Provide your own certificate paths.
    ssl_certificate /etc/ssl/certs/beta.example.com/fullchain.pem;
    ssl_certificate_key /etc/ssl/private/beta.example.com/privkey.pem;

    location = /health {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8000;
    }

    location / {
        allow 203.0.113.7;
        allow 198.51.100.0/24;
        deny all;

        auth_basic "Lattice Private Beta";
        auth_basic_user_file /etc/nginx/.htpasswd-lattice-beta;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://127.0.0.1:8000;
    }
}
